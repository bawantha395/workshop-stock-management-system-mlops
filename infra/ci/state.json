{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private versioned Terraform state and short-lived saved plans. Managed by backend bootstrap workflow.",
  "Parameters": {
    "BucketName": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]"
    },
    "ProjectName": {
      "Type": "String",
      "AllowedPattern": "[a-z][a-z0-9-]{2,19}",
      "Description": "Terraform name prefix, for example stocklane-dev."
    }
  },
  "Resources": {
    "StateBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Ref": "BucketName"
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireSavedPlans",
              "Status": "Enabled",
              "Prefix": "plans/",
              "ExpirationInDays": 7,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": {
              "Ref": "ProjectName"
            }
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "StateBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "StateBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireHttps",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "StateBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${StateBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "StateBucket"
      }
    }
  }
}
