region = "ap-southeast-2"
name = "stocklane-prod"
github_repository = "bawantha395/workshop-stock-management--system-mlops"
github_owner_id = "138287779"
github_repository_id = "1433222676"
github_oidc_subject_style = "immutable"
administrator_arn = "arn:aws:iam::123456789012:role/YOUR_OPERATOR_ROLE"
operator_cidrs = ["203.0.113.10/32"]
api_domain = "api.stocklane.YOUR_OWNED_DOMAIN"
route53_zone_id = "YOUR_HOSTED_ZONE_ID"
budget_email = "YOUR_EMAIL"
deletion_protection = true
database_multi_az = true
# Reuse an existing account-wide provider instead of creating a duplicate:
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

environment = "production"
availability_zone_count = 3
nat_per_az = true
node_min_size = 3
node_desired_size = 3
node_max_size = 6
application_replicas = 3
cache_node_type = "cache.t4g.small"
cache_node_count = 2
